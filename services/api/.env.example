# Database configuration
DB_URL=postgres://postgres:postgres@localhost:5432/fucci_api?sslmode=disable

# Server configuration
PORT=8080
# development | staging | production — staging enables POST /push/test on Fly
ENVIRONMENT=development

# API Keys
FOOTBALL_API_KEY=your_api_key_here

# Realtime news (Open Web Ninja / X-API-Key). If unset, RAPID_API_KEY is used.
NEWS_API_KEY=

# RapidAPI — for Google News (RapidAPI host).
RAPID_API_KEY=

# YouTube Data API v3 — team Shorts on match details (World Cup channel registry).
YOUTUBE_API_KEY=
# Redis TTL for youtube:shorts:* cache keys (hours; default 24).
YOUTUBE_CACHE_TTL_HOURS=24

# Expo push notifications (Phase 1)
EXPO_ACCESS_TOKEN=

# Guideline 1.2 moderation alerts (optional SMTP; logs to server when unset)
MODERATION_NOTIFY_EMAIL=contact@magistri.dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# OpenAI — debate prompt generation + synchronous UGC soft-flag moderation
# (omni-moderation-latest for text/image/video-frame). Soft-flag allows publish
# and queues a pending content_report for human review within 24 hours.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Cloudinary (008 photo upload)
# Used by POST /v1/api/upload/cloudinary/signature
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional unsigned preset (if used instead of signed uploads)
CLOUDINARY_UPLOAD_PRESET=

REDIS_URL=